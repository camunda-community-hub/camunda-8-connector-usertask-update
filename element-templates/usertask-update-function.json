{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "User task update function",
  "id": "org.camunda.connector.usertaskupdate.UserTaskUpdateFunction",
  "description": "Update one or several user tasks: priority, due date, follow-up date, assignment (assignee/unassign), candidate groups, candidate users, and a free-text action label.",
  "documentationRef": "https://docs.camunda.io/docs/components/modeler/web-modeler/connectors/available-connectors/template/",
  "icon": {
    "contents": "data:image/png;base64,\u003d"
  },
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "priority",
      "label": "Priority"
    },
    {
      "id": "due_date",
      "label": "Due date"
    },
    {
      "id": "follow-up_date",
      "label": "Follow-up date"
    },
    {
      "id": "assignment",
      "label": "Assignment"
    },
    {
      "id": "candidate_groups",
      "label": "Candidate groups"
    },
    {
      "id": "candidate_users",
      "label": "Candidate users"
    },
    {
      "id": "Input",
      "label": "Input"
    },
    {
      "id": "Output",
      "label": "Output"
    }
  ],
  "properties": [
    {
      "binding": {
        "type": "zeebe:taskDefinition:type"
      },
      "type": "Hidden",
      "value": "c-usertaskupdate-function"
    },
    {
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden",
      "value": "result"
    },
    {
      "id": "userTaskKey",
      "label": "User task key(s)",
      "description": "userTaskKey or List\u003cuserTaskKey\u003e. Update exactly these user tasks. Takes precedence over processInstanceKey/filterTaskElementId: when set, no search is performed.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "userTaskKey",
        "type": "zeebe:input"
      },
      "group": "Input"
    },
    {
      "id": "processInstanceKey",
      "label": "Process instance key",
      "description": "Search the active (CREATED) user tasks of this process instance and update them. When not set (and userTaskKey is not set), the current process instance is used. Ignored when userTaskKey is set.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "processInstanceKey",
        "type": "zeebe:input"
      },
      "group": "Input"
    },
    {
      "id": "filterTaskElementId",
      "label": "Filter task element id(s)",
      "description": "TaskElementId or List\u003cTaskElementId\u003e. When searching by processInstanceKey, only update these task ids (user task element id). Leave empty to update every active user task found. Ignored when userTaskKey is set.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "filterTaskElementId",
        "type": "zeebe:input"
      },
      "group": "Input"
    },
    {
      "id": "priorityOperation",
      "label": "Priority: operation",
      "description": "NOTHING (default) leaves the priority untouched. INCREASE/DECREASE the current priority by priorityStep, set it to an ABSOLUTE value, set it from priorityLevel (SETLEVEL), or CLEAR it back to the default (50).",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Increase",
          "value": "INCREASE"
        },
        {
          "name": "Decrease",
          "value": "DECREASE"
        },
        {
          "name": "Absolute",
          "value": "ABSOLUTE"
        },
        {
          "name": "Set level",
          "value": "SETLEVEL"
        },
        {
          "name": "Clear",
          "value": "CLEAR"
        }
      ],
      "binding": {
        "name": "priorityOperation",
        "type": "zeebe:input"
      },
      "group": "priority"
    },
    {
      "condition": {
        "property": "priorityOperation",
        "oneOf": [
          "INCREASE",
          "DECREASE"
        ]
      },
      "id": "priorityStep",
      "label": "Priority: step",
      "description": "Step used with priorityOperation\u003dINCREASE/DECREASE to move the current priority. The result is clamped to [0, 100].",
      "value": "10",
      "type": "Number",
      "feel": "optional",
      "binding": {
        "name": "priorityStep",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "priority"
    },
    {
      "condition": {
        "property": "priorityOperation",
        "oneOf": [
          "ABSOLUTE"
        ]
      },
      "id": "priorityAbsoluteValue",
      "label": "Priority: absolute value",
      "description": "Used with priorityOperation\u003dABSOLUTE: the new priority (0-100).",
      "type": "Number",
      "feel": "optional",
      "binding": {
        "name": "priorityAbsoluteValue",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "priority"
    },
    {
      "condition": {
        "property": "priorityOperation",
        "oneOf": [
          "SETLEVEL"
        ]
      },
      "id": "priorityLevel",
      "label": "Priority: level",
      "description": "Used with priorityOperation\u003dSETLEVEL: sets the priority to the value matching this Tasklist priority band (Low\u003d25, Medium\u003d50, High\u003d75, Critical\u003d100).",
      "value": "HIGH",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Low",
          "value": "LOW"
        },
        {
          "name": "Medium",
          "value": "MEDIUM"
        },
        {
          "name": "High",
          "value": "HIGH"
        },
        {
          "name": "Critical",
          "value": "CRITICAL"
        }
      ],
      "binding": {
        "name": "priorityLevel",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "priority"
    },
    {
      "id": "dueDateOperation",
      "label": "Due date: operation",
      "description": "NOTHING (default) leaves the due date untouched. INCREASE/DECREASE the current due date by dueDateStep, set it to an ABSOLUTE value, or CLEAR it (no date).",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Increase",
          "value": "INCREASE"
        },
        {
          "name": "Decrease",
          "value": "DECREASE"
        },
        {
          "name": "Absolute",
          "value": "ABSOLUTE"
        },
        {
          "name": "Clear",
          "value": "CLEAR"
        }
      ],
      "binding": {
        "name": "dueDateOperation",
        "type": "zeebe:input"
      },
      "group": "due_date"
    },
    {
      "condition": {
        "property": "dueDateOperation",
        "oneOf": [
          "INCREASE",
          "DECREASE"
        ]
      },
      "id": "dueDateStep",
      "label": "Due date: step",
      "description": "Used with dueDateOperation\u003dINCREASE/DECREASE: an ISO-8601 duration (e.g. PT2H, P1D) added to or removed from the current due date. If the task has no due date yet, now() is used as the base.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "dueDateStep",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "due_date"
    },
    {
      "condition": {
        "property": "dueDateOperation",
        "oneOf": [
          "ABSOLUTE"
        ]
      },
      "id": "dueDateAbsoluteValue",
      "label": "Due date: absolute value",
      "description": "Used with dueDateOperation\u003dABSOLUTE: the new due date (ISO-8601 date-time, e.g. 2026-12-31T23:59:00Z).",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "dueDateAbsoluteValue",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "due_date"
    },
    {
      "id": "followUpDateOperation",
      "label": "Follow-up date: operation",
      "description": "NOTHING (default) leaves the follow-up date untouched. INCREASE/DECREASE the current follow-up date by followUpDateStep, set it to an ABSOLUTE value, or CLEAR it (no date).",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Increase",
          "value": "INCREASE"
        },
        {
          "name": "Decrease",
          "value": "DECREASE"
        },
        {
          "name": "Absolute",
          "value": "ABSOLUTE"
        },
        {
          "name": "Clear",
          "value": "CLEAR"
        }
      ],
      "binding": {
        "name": "followUpDateOperation",
        "type": "zeebe:input"
      },
      "group": "follow-up_date"
    },
    {
      "condition": {
        "property": "followUpDateOperation",
        "oneOf": [
          "INCREASE",
          "DECREASE"
        ]
      },
      "id": "followUpDateStep",
      "label": "Follow-up date: step",
      "description": "Used with followUpDateOperation\u003dINCREASE/DECREASE: an ISO-8601 duration (e.g. PT2H, P1D) added to or removed from the current follow-up date. If the task has no follow-up date yet, now() is used as the base.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "followUpDateStep",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "follow-up_date"
    },
    {
      "condition": {
        "property": "followUpDateOperation",
        "oneOf": [
          "ABSOLUTE"
        ]
      },
      "id": "followUpDateAbsoluteValue",
      "label": "Follow-up date: absolute value",
      "description": "Used with followUpDateOperation\u003dABSOLUTE: the new follow-up date (ISO-8601 date-time).",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "followUpDateAbsoluteValue",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "follow-up_date"
    },
    {
      "id": "assigneeOperation",
      "label": "Assignment: operation",
      "description": "NOTHING (default) leaves the assignment untouched. FORCEASSIGN sets assignee unconditionally; ASSIGN sets it only if the task is not already assigned; CLEAR unassigns the task.",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Force assign",
          "value": "FORCEASSIGN"
        },
        {
          "name": "Assign if not assigned",
          "value": "ASSIGN"
        },
        {
          "name": "Unassign",
          "value": "CLEAR"
        }
      ],
      "binding": {
        "name": "assigneeOperation",
        "type": "zeebe:input"
      },
      "group": "assignment"
    },
    {
      "condition": {
        "property": "assigneeOperation",
        "oneOf": [
          "FORCEASSIGN",
          "ASSIGN"
        ]
      },
      "id": "assignee",
      "label": "Assignee",
      "description": "Used with assigneeOperation\u003dFORCEASSIGN/ASSIGN: set this user as the assignee of the task.",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "assignee",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "assignment"
    },
    {
      "id": "candidateGroupsOperation",
      "label": "Candidate groups: operation",
      "description": "NOTHING (default) leaves candidate groups untouched. FORCEASSIGN sets candidateGroupsValue unconditionally; ASSIGN sets it only if the task has no candidate group yet; CLEAR removes every candidate group; ADD/REMOVE add or remove candidateGroupsValue from the task\u0027s current candidate groups.",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Force assign",
          "value": "FORCEASSIGN"
        },
        {
          "name": "Assign if not assigned",
          "value": "ASSIGN"
        },
        {
          "name": "Clear",
          "value": "CLEAR"
        },
        {
          "name": "Add",
          "value": "ADD"
        },
        {
          "name": "Remove",
          "value": "REMOVE"
        }
      ],
      "binding": {
        "name": "candidateGroupsOperation",
        "type": "zeebe:input"
      },
      "group": "candidate_groups"
    },
    {
      "condition": {
        "property": "candidateGroupsOperation",
        "oneOf": [
          "FORCEASSIGN",
          "ASSIGN",
          "ADD",
          "REMOVE"
        ]
      },
      "id": "candidateGroupsValue",
      "label": "Candidate groups: value",
      "description": "Used with candidateGroupsOperation\u003dFORCEASSIGN/ASSIGN/ADD/REMOVE. Input is a String of GroupId, separated by comma, or a List of GroupId (String).",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "candidateGroupsValue",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "candidate_groups"
    },
    {
      "id": "candidateUsersOperation",
      "label": "Candidate users: operation",
      "description": "NOTHING (default) leaves candidate users untouched. FORCEASSIGN sets candidateUsersValue unconditionally; ASSIGN sets it only if the task has no candidate user yet; CLEAR removes every candidate user; ADD/REMOVE add or remove candidateUsersValue from the task\u0027s current candidate users.",
      "value": "NOTHING",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Nothing",
          "value": "NOTHING"
        },
        {
          "name": "Force assign",
          "value": "FORCEASSIGN"
        },
        {
          "name": "Assign if not assigned",
          "value": "ASSIGN"
        },
        {
          "name": "Clear",
          "value": "CLEAR"
        },
        {
          "name": "Add",
          "value": "ADD"
        },
        {
          "name": "Remove",
          "value": "REMOVE"
        }
      ],
      "binding": {
        "name": "candidateUsersOperation",
        "type": "zeebe:input"
      },
      "group": "candidate_users"
    },
    {
      "condition": {
        "property": "candidateUsersOperation",
        "oneOf": [
          "FORCEASSIGN",
          "ASSIGN",
          "ADD",
          "REMOVE"
        ]
      },
      "id": "candidateUsersValue",
      "label": "Candidate users: value",
      "description": "Used with candidateUsersOperation\u003dFORCEASSIGN/ASSIGN/ADD/REMOVE. Input is a String of UserName, separated by comma, or a List of UserName (String).",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "candidateUsersValue",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "candidate_users"
    },
    {
      "id": "updatedUserTasks_optional",
      "label": "Saved Updated user tasks?",
      "description": "List, one record per updated user task, with the userTaskKey/elementId/processInstanceKey and the resulting value of each operation that was applied on it (priority, dueDate, followUpDate, assignee, candidateGroups, candidateUsers, action).",
      "value": "false",
      "binding": {
        "name": "updatedUserTasks_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "updatedUserTasks_optional",
        "equals": "true"
      },
      "id": "updatedUserTasks",
      "label": "Updated user tasks",
      "description": "List, one record per updated user task, with the userTaskKey/elementId/processInstanceKey and the resulting value of each operation that was applied on it (priority, dueDate, followUpDate, assignee, candidateGroups, candidateUsers, action).",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.updatedUserTasks",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "label": "ControllerPage Expression",
      "description": "Expression to define BPMN Errors to throw",
      "type": "Hidden",
      "value": "if is defined(error) then bpmnError(error.code, error.message) else null",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      }
    }
  ]
}